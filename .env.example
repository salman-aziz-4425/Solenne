# OpenAI is the default. Put the key here; this file is only a template.
OPENAI_API_KEY=
MODEL=openai:gpt-6-sol

# Local Ollama instead:
# MODEL=ollama:qwen3.5:9b
# ANTHROPIC_API_KEY=
# MODEL=anthropic:claude-sonnet-4-5
# GOOGLE_API_KEY=
# MODEL=google_genai:gemini-2.5-flash

# LangSmith tracing for every agent run
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-coding-agent

# WORKSPACE=./workspace
# RECURSION_LIMIT=80
